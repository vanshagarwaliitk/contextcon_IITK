# --- Keys (never commit the real .env) ---
CRUSTDATA_API_KEY=
ANTHROPIC_API_KEY=

# --- LLM ("Claude's brain") ---
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (Opus 5.5 default is medium)
LLM_EFFORT=medium
# 1 = server-side refusal fallback (beta server-side-fallback-2026-07-01)
LLM_FALLBACKS=1

# --- Provider mode: live | replay ---
PROVIDER_MODE=live
# 1 = save every live Crustdata response into fixtures/ (for replay mode)
RECORD=0

# --- Budget guards ---
CREDIT_BUDGET=150
MAX_API_CALLS=60
MAX_PROBES=25

# --- Feature flags ---
ENABLE_PEOPLE=1
ENABLE_WEB=1

# --- Chaos testing: comma-separated endpoints to force-fail, e.g. /job/search ---
FAIL_ENDPOINT=
# 1 = pretend the LLM is down (deterministic templated report)
FAIL_LLM=0

DB_PATH=coredata.db
